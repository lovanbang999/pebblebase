# Pebblebase environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# Master encryption key for stored connection passwords (AES-256-GCM).
# Generate with: openssl rand -base64 32
# If not set, a key will be auto-generated and stored at <data-dir>/.master.key
# (convenient for local dev, NOT recommended for team/production use).
PEBBLEBASE_MASTER_KEY=

# Server port (default: 8080)
PORT=8080
